# Copy this file to .env and fill in what you use. Restart `npx expo start`
# after any change.

# --- Real email via EmailJS (quickest path, free tier: 200 emails/month) ---
# 1. Sign up at https://www.emailjs.com
# 2. Email Services → Add New Service (e.g. Gmail) → copy the Service ID
# 3. Email Templates → Create New Template:
#      - Set "To email" field to: {{to_email}}
#      - Subject: {{subject}}
#      - Body: include the line: Your Vela code is {{code}}
#    → copy the Template ID
# 4. Account → General → copy your Public Key
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- OR: real email via your own backend (production path) ---
# POST endpoint receiving { email, code, type }; server sends the email.
EXPO_PUBLIC_EMAIL_API_URL=

# If none of the above are set, the app runs in demo mode and shows the
# verification code on screen.

# --- Optional: crash reporting ---
EXPO_PUBLIC_SENTRY_DSN=

# --- Optional: future cloud sync ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
